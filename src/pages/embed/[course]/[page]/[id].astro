---
// A single interactive component on its own page, for embedding as an iframe (e.g. in Obsidian).
// Theme follows the viewer's system setting; force one with ?theme=dark or ?theme=light.
import '../../../../../node_modules/@astrojs/starlight/dist/style/props.css';
import '@fontsource-variable/quicksand';
import '../../../../styles/theme.css';
import '../../../../styles/custom.css';
import AddressTranslation from '../../../../components/AddressTranslation.tsx';
import AmatBar from '../../../../components/AmatBar.tsx';
import AmdahlExplorer from '../../../../components/AmdahlExplorer.tsx';
import ArrayLayout from '../../../../components/ArrayLayout.tsx';
import BasicBlocks from '../../../../components/BasicBlocks.tsx';
import BuddyAllocator from '../../../../components/BuddyAllocator.tsx';
import BypassPaths from '../../../../components/BypassPaths.tsx';
import CacheSim from '../../../../components/CacheSim.tsx';
import CoalesceCases from '../../../../components/CoalesceCases.tsx';
import CodeSteps from '../../../../components/CodeSteps.tsx';
import CompilerFlow from '../../../../components/CompilerFlow.tsx';
import CpuDatapath from '../../../../components/CpuDatapath.tsx';
import ExecTimeline from '../../../../components/ExecTimeline.tsx';
import FuSchedule from '../../../../components/FuSchedule.tsx';
import GcGraph from '../../../../components/GcGraph.tsx';
import HeapSim from '../../../../components/HeapSim.tsx';
import InsnBufferPipeline from '../../../../components/InsnBufferPipeline.tsx';
import IssueSlots from '../../../../components/IssueSlots.tsx';
import MatrixAccess from '../../../../components/MatrixAccess.tsx';
import MemFigure from '../../../../components/MemFigure.tsx';
import MemoryHierarchy from '../../../../components/MemoryHierarchy.tsx';
import MisalignedRead from '../../../../components/MisalignedRead.tsx';
import OooTimeline from '../../../../components/OooTimeline.tsx';
import OptimizationLadder from '../../../../components/OptimizationLadder.tsx';
import PhkMalloc from '../../../../components/PhkMalloc.tsx';
import PipelineDiagram from '../../../../components/PipelineDiagram.tsx';
import PipelineSim from '../../../../components/PipelineSim.tsx';
import ReductionTree from '../../../../components/ReductionTree.tsx';
import RenameDemo from '../../../../components/RenameDemo.tsx';
import SamplingProfiler from '../../../../components/SamplingProfiler.tsx';
import SegregatedLists from '../../../../components/SegregatedLists.tsx';
import ServerTimeline from '../../../../components/ServerTimeline.tsx';
import StridePrefetcher from '../../../../components/StridePrefetcher.tsx';
import StructLayout from '../../../../components/StructLayout.tsx';
import ThroughputCurve from '../../../../components/ThroughputCurve.tsx';
import TilingViz from '../../../../components/TilingViz.tsx';
import TlbReach from '../../../../components/TlbReach.tsx';
import VirtualMapping from '../../../../components/VirtualMapping.tsx';
import { embeds, type EmbedEntry } from '../../../../embeds';

export function getStaticPaths() {
	return embeds.map((e) => ({ params: { course: e.course, page: e.page, id: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props as { entry: EmbedEntry };
const { component: c, props, title } = entry.embed;
const p = props as any;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<script is:inline>
			try {
				const forced = new URLSearchParams(location.search).get('theme');
				const light = matchMedia('(prefers-color-scheme: light)').matches;
				document.documentElement.dataset.theme = forced === 'light' || forced === 'dark' ? forced : light ? 'light' : 'dark';
			} catch {}
		</script>
	</head>
	<body>
		{c === 'AddressTranslation' && <AddressTranslation client:load {...p} />}
		{c === 'AmatBar' && <AmatBar client:load {...p} />}
		{c === 'AmdahlExplorer' && <AmdahlExplorer client:load {...p} />}
		{c === 'ArrayLayout' && <ArrayLayout client:load {...p} />}
		{c === 'BasicBlocks' && <BasicBlocks client:load {...p} />}
		{c === 'BuddyAllocator' && <BuddyAllocator client:load {...p} />}
		{c === 'BypassPaths' && <BypassPaths client:load {...p} />}
		{c === 'CacheSim' && <CacheSim client:load {...p} />}
		{c === 'CoalesceCases' && <CoalesceCases client:load {...p} />}
		{c === 'CodeSteps' && <CodeSteps client:load {...p} />}
		{c === 'CompilerFlow' && <CompilerFlow client:load {...p} />}
		{c === 'CpuDatapath' && <CpuDatapath client:load {...p} />}
		{c === 'ExecTimeline' && <ExecTimeline client:load {...p} />}
		{c === 'FuSchedule' && <FuSchedule client:load {...p} />}
		{c === 'GcGraph' && <GcGraph client:load {...p} />}
		{c === 'HeapSim' && <HeapSim client:load {...p} />}
		{c === 'InsnBufferPipeline' && <InsnBufferPipeline client:load {...p} />}
		{c === 'IssueSlots' && <IssueSlots client:load {...p} />}
		{c === 'MatrixAccess' && <MatrixAccess client:load {...p} />}
		{c === 'MemFigure' && <MemFigure client:load {...p} />}
		{c === 'MemoryHierarchy' && <MemoryHierarchy client:load {...p} />}
		{c === 'MisalignedRead' && <MisalignedRead client:load {...p} />}
		{c === 'OooTimeline' && <OooTimeline client:load {...p} />}
		{c === 'OptimizationLadder' && <OptimizationLadder client:load {...p} />}
		{c === 'PhkMalloc' && <PhkMalloc client:load {...p} />}
		{c === 'PipelineDiagram' && <PipelineDiagram client:load {...p} />}
		{c === 'PipelineSim' && <PipelineSim client:load {...p} />}
		{c === 'ReductionTree' && <ReductionTree client:load {...p} />}
		{c === 'RenameDemo' && <RenameDemo client:load {...p} />}
		{c === 'SamplingProfiler' && <SamplingProfiler client:load {...p} />}
		{c === 'SegregatedLists' && <SegregatedLists client:load {...p} />}
		{c === 'ServerTimeline' && <ServerTimeline client:load {...p} />}
		{c === 'StridePrefetcher' && <StridePrefetcher client:load {...p} />}
		{c === 'StructLayout' && <StructLayout client:load {...p} />}
		{c === 'ThroughputCurve' && <ThroughputCurve client:load {...p} />}
		{c === 'TilingViz' && <TilingViz client:load {...p} />}
		{c === 'TlbReach' && <TlbReach client:load {...p} />}
		{c === 'VirtualMapping' && <VirtualMapping client:load {...p} />}
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		background: transparent;
		color: var(--sl-color-text);
		font-family: var(--__sl-font);
		font-size: 16px;
		line-height: 1.5;
	}
	body {
		padding: 2px;
	}
	body .not-content {
		margin-block: 0 !important;
	}
</style>
