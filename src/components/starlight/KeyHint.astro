---
// Tiny "press [ to hide" hint pinned to the bottom of a side panel.
interface Props {
	keyName: string;
	action: string;
	class?: string;
}
const { keyName, action, class: className } = Astro.props;
---

<p class:list={['key-hint', className]}>
	<kbd>{keyName}</kbd>
	<span>{action}</span>
</p>

<style>
	.key-hint {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0.6rem 0;
		font-size: var(--sl-text-2xs);
		color: var(--sl-color-gray-4);
		user-select: none;
	}
	kbd {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.35rem;
		height: 1.35rem;
		padding: 0 0.3rem;
		border: 1px solid var(--sl-color-gray-5);
		border-bottom-width: 2px;
		border-radius: 0.3rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-2);
		font-family: var(--__sl-font-mono);
		font-size: 0.7rem;
		line-height: 1;
	}
	@media print {
		.key-hint {
			display: none;
		}
	}
</style>
